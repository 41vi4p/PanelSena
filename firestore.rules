rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper: is the requester a linked display client granted access to `userId`'s resources?
    // Grant docs are created by the dashboard on link, with id `${ownerUid}_${clientUid}`.
    function isAuthorizedClient(userId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/displayAccess/$(userId + '_' + request.auth.uid));
    }

    // Cross-account access grants. Owner manages grants; the granted client can read its own grant.
    match /displayAccess/{grantId} {
      allow read: if isAuthenticated() &&
        (isOwner(resource.data.ownerUid) || isOwner(resource.data.clientUid));
      allow create, update: if isAuthenticated() && isOwner(request.resource.data.ownerUid);
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerUid);
    }

    // Users collection
    match /users/{userId} {
      // Users can read and write their own profile
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Displays collection
    match /displays/{displayId} {
      // Owner, or a linked client granted access, can read the display
      allow read: if isAuthenticated() &&
        (isOwner(resource.data.userId) || isAuthorizedClient(resource.data.userId));

      // Users can create displays for themselves
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);

      // Users can update and delete their own displays
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Content collection
    match /content/{contentId} {
      // Owner, or a linked client granted access, can read the content
      allow read: if isAuthenticated() &&
        (isOwner(resource.data.userId) || isAuthorizedClient(resource.data.userId));

      // Users can create content for themselves
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);

      // Users can update and delete their own content
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Schedules collection
    match /schedules/{scheduleId} {
      // Owner, or a linked client granted access, can read the schedule
      allow read: if isAuthenticated() &&
        (isOwner(resource.data.userId) || isAuthorizedClient(resource.data.userId));

      // Users can create schedules for themselves
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);

      // Users can update and delete their own schedules
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Activities collection
    match /activities/{activityId} {
      // Users can read activities they own
      allow read: if isAuthenticated() && isOwner(resource.data.userId);

      // Users can create activities for themselves
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);

      // Activities are read-only after creation (no updates or deletes)
      allow update, delete: if false;
    }

    // Analytics collection
    match /analytics/{analyticsId} {
      // Users can read analytics they own
      allow read: if isAuthenticated() && isOwner(resource.data.userId);

      // Users can create analytics for themselves
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);

      // Analytics are read-only after creation
      allow update, delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
